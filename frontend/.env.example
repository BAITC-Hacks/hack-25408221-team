NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_WS_URL=ws://localhost
# For Hetzner IP (no domain):
# NEXT_PUBLIC_API_URL=http://<IP>
# NEXT_PUBLIC_WS_URL=ws://<IP>
# For nip.io TLS (free TLS without buying a domain):
# NEXT_PUBLIC_API_URL=https://<IP>.nip.io
# NEXT_PUBLIC_WS_URL=wss://<IP>.nip.io

# Feature flags (lib/feature-flags.ts). Comma-separated flag names to enable,
# e.g. "new_scoring_ui,beta_dashboard". Empty means every flag is off.
NEXT_PUBLIC_FEATURE_FLAGS=
