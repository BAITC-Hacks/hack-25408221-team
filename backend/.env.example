GEMINI_API_KEY=sk-...
# ── Database ───────────────────────────────────────────────────────────────
# Local / Hetzner (hel1 CX22, no IAM):
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me-generate-a-real-secret
DB_NAME=postgres
DB_USE_IAM_AUTH=false
DB_REGION=us-east-1
# Postgres image vars — keep in sync with DB_* above (Compose loads them via env_file).
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-generate-a-real-secret
# For AWS RDS IAM (legacy, not needed on Hetzner/local):
# DB_HOST=database-1.cluster-cehoeeceo4yq.us-east-1.rds.amazonaws.com
# DB_USE_IAM_AUTH=true

# ── Storage ────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
# Empty = local volume ./uploads (default, works locally + on VPS).
# For MinIO (S3-compatible) set bucket + endpoint:
# AWS_S3_BUCKET=invision
# AWS_ENDPOINT_URL=http://minio:9000
AWS_S3_BUCKET=
AWS_ENDPOINT_URL=
# Legacy AWS bucket (not needed on Hetzner/local):
# AWS_S3_BUCKET=invision-046573763502-eu-west-1-an

MODEL=gemini-3.1-flash-live-preview
MAX_INTERVIEW_DURATION=300
# Required, no default — generate with `openssl rand -hex 32`. The app will
# fail to start without this set.
JWT_SECRET=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
# Local: http://localhost,http://localhost:80,http://127.0.0.1:3000
# Hetzner IP: http://<IP>
# nip.io TLS later: https://<IP>.nip.io
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=500
PRESIGNED_URL_EXPIRY_HOURS=1
# Empty disables the /api/admin/create-admin endpoint entirely.
ADMIN_CREATION_SECRET=

# Live-interview silence check-in behavior (app/api/websocket.py)
CHECKIN_SILENCE_INTERVAL_SECONDS=20
CHECKIN_WAIT_SECONDS=15
MAX_CHECKINS=2

# Evaluation-save robustness (app/interview/handler.py)
EVALUATION_SAVE_MAX_ATTEMPTS=3
EVALUATION_SAVE_RETRY_DELAY_SECONDS=0.5

# Feature flags (app/core/feature_flags.py). Comma-separated flag names to
# enable, e.g. "new_scoring_ui,beta_dashboard". Empty means every flag is off.
FEATURE_FLAGS=

# Hetzner / VPS extras (optional):
# DOMAIN=65.21.12.34.nip.io   # for Caddy TLS via Let's Encrypt without buying a domain
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin123
